# Never commit a populated production environment file.
JEV_MODE=live
TYPESAFE_API_KEY=replace-with-typesafe-provider-key
JEV_MODEL=jev-1.14.0
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_SECONDS=15
JEV_MAX_ATTEMPTS=3
JEV_RETRY_BASE_SECONDS=0.25
JEV_RETRY_MAX_SECONDS=2

API_AUTH_ENABLED=true
CLIENT_API_KEYS=integration-client:replace-with-generated-high-entropy-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/triage.db
PORT=8000
