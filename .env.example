# Evaluator: "mock" runs offline; "live" sends ticket text to TypeSafe.
JEV_MODE=mock

# Required only in live mode. Create one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_SECONDS=15

# Total calls including the first attempt. Retries only transient transport,
# 429, 529, and selected 5xx failures.
JEV_MAX_ATTEMPTS=3
JEV_RETRY_BASE_SECONDS=0.25
JEV_RETRY_MAX_SECONDS=2

# Inbound developer authentication. Local mock mode may leave this false.
# Live mode requires true plus at least one client-id:secret pair.
API_AUTH_ENABLED=false
CLIENT_API_KEYS=
# Example (generate your own secrets): partner-a:secret-one,partner-b:secret-two

# Sliding-window quota per client. This implementation is process-local.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./triage.db
