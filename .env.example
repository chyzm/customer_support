# "mock" runs offline with canned heuristics (no key needed). "live" calls TypeSafe.
JEV_MODE=mock

# Only required when JEV_MODE=live. Create one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Pinned on purpose: "jev-latest" is an alias that moves, which silently shifts your thresholds.
JEV_MODEL=jev-1.14.0
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_SECONDS=15

DATABASE_URL=
